(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

api.lorekit.online {
	import security_headers
	encode zstd gzip
	reverse_proxy api:3000
}

app.lorekit.online {
	import security_headers
	encode zstd gzip
	root * /srv/web

	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://api.lorekit.online; img-src 'self' blob: data: https://api.lorekit.online"
	}

	@index path / /index.html
	header @index Cache-Control "no-store"

	@immutable path_regexp immutable ^/.*\.[A-Z0-9]{8,}\.(js|css|woff2?|png|jpe?g|webp|gif|avif|svg)$
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	try_files {path} /index.html
	file_server
}
